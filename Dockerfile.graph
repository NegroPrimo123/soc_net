# Multi-stage build for GoSocial Graph & Ranking gRPC Microservice
FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o graph_service ./cmd/graph_service

FROM alpine:3.20
WORKDIR /app
RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/graph_service /app/graph_service

EXPOSE 50051
ENV GRPC_PORT=50051
CMD ["/app/graph_service"]
